    "import torch\n",
    "\n",
    "@torch.no_grad()\n",
    "def rollout_step_residual6(model, xk, uk, dt,\n",
    "                           mass=2.0,\n",
    "                           inertia=torch.tensor([0.0217, 0.0217, 0.04]),\n",
    "                           g=9.81):\n",
    "    if dt.ndim == 1:\n",
    "        dt = dt.view(-1, 1)\n",
    "\n",
    "    delta_vw = denormalize_delta_vw(model(xk, uk))\n",
    "    x_next = compute_new_pos_angles(delta_vw, xk, uk, dt, mass, inertia, g)\n",
    "    return x_next\n"
   ]
