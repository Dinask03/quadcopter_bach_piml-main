    "def combined_dynamics(model, x, u, mass, inertia, g):\n",
    "    xdot = system_dynamics(x, u, mass, inertia, g)\n",
    "    delta = denormalize_delta_vw(model(x, u))\n",
    "    xdot[:, 6:9]  += delta[:, 0:3]\n",
    "    xdot[:, 9:12] += delta[:, 3:6]\n",
    "    return xdot\n"
   ]
